# DOMAIN задаётся в файле .env (например, vayrassrochka.ru). Пока он не задан, сайт работает по http на порту 80.
{$DOMAIN::80} {
	encode gzip
	handle /api/* {
		reverse_proxy api:3000
	}
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		-Server
	}
	# Служебный файл сервис-воркера не кэшируем
	@sw path /sw.js
	header @sw Cache-Control "no-cache"
}
